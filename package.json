{
  "name": "utilis-app",
  "version": "1.0.0",
  "description": "Utility Management System",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "install-all": "npm install && cd backend && npm install",
    "backend": "node backend/server.js",
    "frontend": "npx http-server ./frontend -p 8080 -c-1 -o",
    "dev": "npx concurrently \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "http-server": "^14.1.1",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.1",
    "pg": "^8.11.3"
  }
}
