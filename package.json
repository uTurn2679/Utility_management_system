{
  "name": "utilis-app",
  "version": "1.0.0",
  "description": "Utility Management System",
  "scripts": {
    "install-all": "npm install && cd backend && npm install",
    "backend": "node backend/server.js",
    "frontend": "npx http-server ./frontend -p 8080 -c-1 -o",
    "dev": "npx concurrently \"npm run backend\" \"npm run frontend\""
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "http-server": "^14.1.1"
  }
}
